<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AddEditIngredientActivity">

    <!-- Kitchen background -->
    <ImageView
        android:id="@+id/kitchenBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/kitchen_background"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Translucent white overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#BFFFFFFF"
        android:paddingTop="24dp"
        android:paddingBottom="8dp">

        <!-- Back button in the top-left corner -->
        <Button
            android:id="@+id/buttonBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5F6F52"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Lowered title -->
        <TextView
            android:id="@+id/textAddEditTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Add Ingredient"
            android:textColor="#222222"
            android:textSize="24sp"
            android:textStyle="bold"
            android:padding="16dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/buttonBack"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/editIngredientName"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:hint="Ingredient name"
            android:inputType="text"
            android:backgroundTint="#5F6F52"
            android:layout_margin="16dp"
            app:layout_constraintTop_toBottomOf="@id/textAddEditTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/editIngredientQuantity"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:hint="Quantity"
            android:inputType="numberDecimal"
            android:backgroundTint="#5F6F52"
            android:layout_margin="16dp"
            app:layout_constraintTop_toBottomOf="@id/editIngredientName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/editIngredientUnit"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:hint="Unit"
            android:inputType="text"
            android:backgroundTint="#5F6F52"
            android:layout_margin="16dp"
            app:layout_constraintTop_toBottomOf="@id/editIngredientQuantity"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/editIngredientExpiry"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:hint="Expiry date (optional)"
            android:inputType="date"
            android:backgroundTint="#5F6F52"
            android:layout_margin="16dp"
            app:layout_constraintTop_toBottomOf="@id/editIngredientUnit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/buttonSaveIngredient"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="Save Ingredient"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5F6F52"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/editIngredientExpiry"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>